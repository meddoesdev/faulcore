# Copy this file to .env and replace only the values in the local copy.
# .env is ignored by Git. Never commit or paste provider keys into a run request.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Approved run-level provider order and model defaults.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_MODEL=xingchen-agi/xing4.0-29b-a4b:free

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=RecallScope

# Leave LLM_PROVIDER unset for Groq -> Gemini -> OpenRouter -> mock failover.
# Set it to groq, gemini, openrouter, or mock only when testing one provider.
# LLM_PROVIDER=
